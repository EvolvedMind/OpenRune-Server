[[interface]]
name = "interface.commands_menu"
# Keep this interface standalone for revision 240. The current FileStore inherit merger
# resolves an overlay back onto the inherited base id/name, which would make the
# component.commands_menu:* mappings point at the wrong interface.
width = 512
height = 334
on_load = [
  "clientscript.commands_menu_init",
  "component.commands_menu:frame",
  "component.commands_menu:searchbar",
  "component.commands_menu:clear_search",
  "component.commands_menu:previous",
  "component.commands_menu:next",
  "component.commands_menu:use",
]

[[component]]
name = "frame"
type = "layer"
x = 0
y = 0
width = 512
height = 334
no_click_through = true

[[component]]
name = "find_label"
type = "text"
x = 25
y = 40
width = 62
height = 22
text = "Find"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "searchbar"
type = "layer"
x = 94
y = 40
width = 320
height = 22

